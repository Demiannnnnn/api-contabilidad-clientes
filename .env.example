# ─── Server Configuration ───────────────────────────────
# URL base pública del servidor API
API_URL=http://localhost:3000
# Puerto en el que escucha el servidor HTTP
PORT=3000
# Host de enlace (localhost o 0.0.0.0)
HOST=localhost
# Entorno de ejecución: development, test, production
NODE_ENV=development
# Origen permitido para CORS (e.g. http://localhost:5173 o *)
CORS_ORIGIN=*

# ─── Database (PostgreSQL) ──────────────────────────────
# Usuario de PostgreSQL para el contenedor Docker y la conexión
DB_USER=CHANGE_ME
# Contraseña de PostgreSQL para el contenedor Docker y la conexión
DB_PASSWORD=CHANGE_ME
# Nombre de la base de datos PostgreSQL
DB_NAME=CHANGE_ME
# URL completa de conexión a PostgreSQL utilizada por Prisma ORM
DATABASE_URL="postgresql://CHANGE_ME:CHANGE_ME@localhost:5432/CHANGE_ME?schema=public"

# ─── Autenticación & JWT ────────────────────────────────
# Clave secreta para la firma y verificación de tokens JWT (usar cadena aleatoria segura)
JWT_SECRET=CHANGE_ME
# Tiempo de expiración del token de acceso (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES=15m
# Duración en días de validez para los refresh tokens en base de datos
REFRESH_TOKEN_DAYS=30

# ─── Rate Limiting ──────────────────────────────────────
# Ventana de tiempo general en milisegundos (default: 60000 = 1 min)
RATE_LIMIT_WINDOW_MS=60000
# Máximo de peticiones por ventana general (default: 100)
RATE_LIMIT_MAX=100
# Ventana de tiempo para autenticación en milisegundos (default: 900000 = 15 min)
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Máximo de intentos para rutas de autenticación (default: 5)
AUTH_RATE_LIMIT_MAX=5

# ─── Logging ────────────────────────────────────────────
# Nivel de logging: info, debug
LOG_LEVEL=info
