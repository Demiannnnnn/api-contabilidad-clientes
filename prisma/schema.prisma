generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../docs/erd.svg"
}


// ============================================
// Usuario — matching app's SQLite users table
// ============================================
model User {
  id                    Int       @id @default(autoincrement())
  email                 String    @unique
  passwordHash          String
  rut                   String?
  nombre                String?
  rol                   String    @default("vendedor")  // dueño, administrador, vendedor, cajero, contador
  permisos              String    @default("{}")         // JSON de permisos granulares
  activo                Boolean   @default(true)
  requiereAutorizacion  Boolean   @default(false)
  ultimoAcceso          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  clientes              Cliente[]
  productos             Producto[]
  documentos            Documento[]
  trabajadores          Trabajador[]
  categorias            Categoria[]

  // Relación Contador
  clientesAsignados     ContadorCliente[] @relation("ContadorRelation")
  miContador            ContadorCliente?  @relation("ClienteRelation")

  // Relación Licence
  licence               Licence[]

  // Relación RefreshToken
  refreshTokens         RefreshToken[]
}

// Relación Contador <-> Clientes
model ContadorCliente {
  id         Int      @id @default(autoincrement())
  contadorId Int
  contador   User     @relation("ContadorRelation", fields: [contadorId], references: [id])
  clienteId  Int      @unique
  cliente    User     @relation("ClienteRelation", fields: [clienteId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([contadorId, clienteId])
}

// ============================================
// Clientes — matching app's SQLite clientes table
// ============================================
model Cliente {
  id                  Int       @id @default(autoincrement())
  userId              Int
  user                User      @relation(fields: [userId], references: [id])

  rut                 String
  razonSocial         String
  nombreFantasia      String?
  giro                String?
  direccion           String?
  region              String?
  comuna              String?
  ciudad              String?
  telefono            String?
  email               String?

  tipoDocumento       String    @default("rut_empresa")
  contactoNombre      String?
  contactoCargo       String?
  contactoEmail       String?
  contactoTelefono    String?

  condicionPago       String    @default("contado")
  diasCredito         Int       @default(0)
  limiteCredito       Decimal   @default(0) @db.Decimal(12, 0)
  descuentoAutomatico Decimal   @default(0) @db.Decimal(5, 2)
  vendedorId          Int?
  zona                String?
  listaPrecios        String    @default("normal")

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  documentos          Documento[]

  @@unique([userId, rut])
}

// Productos o servicios
model Producto {
  id          Int             @id @default(autoincrement())
  userId      Int
  user        User            @relation(fields: [userId], references: [id])
  codigo      String
  nombre      String
  descripcion String?
  precio      Decimal         @db.Decimal(10, 0)  // Sin decimales (pesos chilenos)
  stock       Int             @default(0)
  exento      Boolean         @default(false)     // ¿Exento de IVA?
  activo      Boolean         @default(true)

  // Campos adicionales que envía la app
  unidadMedida  String?       @default("UN")
  stockMinimo   Int           @default(0)
  stockMaximo   Int?
  costo         Decimal?      @db.Decimal(10, 0)
  localId       Int?          // ID local de la app para sync
  syncHash      String?
  syncStatus    String?       @default("synced")
  lastSyncedAt  DateTime?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       DocumentoItem[]

  categoriaId Int?
  categoria   Categoria?  @relation(fields: [categoriaId], references: [id])

  @@unique([userId, codigo])
}

// Documento tributario (Factura o Boleta)
model Documento {
  id          Int              @id @default(autoincrement())
  userId      Int
  user        User             @relation(fields: [userId], references: [id])
  
  // Tipo y número
  tipo        TipoDocumento
  numero      Int              // Folio
  
  // Fecha
  fecha       DateTime         @default(now())
  
  // Cliente (opcional para boletas)
  clienteId   Int?
  cliente     Cliente?         @relation(fields: [clienteId], references: [id])
  
  // Montos (pesos chilenos, sin decimales)
  neto        Decimal          @db.Decimal(10, 0)
  iva         Decimal          @db.Decimal(10, 0)  // 19%
  total       Decimal          @db.Decimal(10, 0)
  
  // Estado
  estado      EstadoDocumento  @default(EMITIDO)
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       DocumentoItem[]

  //Conexion con trabajador
  trabajadorId Int?
  trabajador  Trabajador? @relation(fields: [trabajadorId], references: [id])

  @@unique([userId, tipo, numero])  // Folio único por tipo
}

enum TipoDocumento {
  FACTURA_ELECTRONICA     // Factura afecta
  FACTURA_EXENTA          // Factura exenta de IVA
  BOLETA_ELECTRONICA      // Boleta afecta
  BOLETA_EXENTA           // Boleta exenta
  NOTA_CREDITO            // Anula o modifica factura
  NOTA_DEBITO             // Aumenta monto
  GUIA_DESPACHO           // Traslado de mercadería
}

enum EstadoDocumento {
  BORRADOR    // Aún no emitido
  EMITIDO     // Emitido al SII
  ANULADO     // Anulado con nota de crédito
}

// Items del documento
model DocumentoItem {
  id          Int       @id @default(autoincrement())
  documentoId Int
  documento   Documento @relation(fields: [documentoId], references: [id])
  productoId  Int
  producto    Producto  @relation(fields: [productoId], references: [id])
  
  cantidad    Int
  precio      Decimal   @db.Decimal(10, 0)
  descuento   Decimal   @db.Decimal(10, 0) @default(0)
  exento      Boolean   @default(false)
  subtotal    Decimal   @db.Decimal(10, 0)
}

// Trabajador de empresa
model Trabajador{
  id          Int       @id @default(autoincrement())
  userId      Int       
  user        User      @relation(fields:[userId], references: [id])
  nombre      String
  rut         String
  cargo       String?
  email       String?
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  documentos Documento[]

  @@unique([userId, rut])
}

//Categoria
model Categoria{
  id          Int         @id @default(autoincrement())
  userId      Int
  user        User        @relation(fields:[userId], references: [id])
  nombre      String
  createdAt   DateTime    @default(now())
  productos   Producto[]

  @@unique([userId, nombre])
}

// Refresh tokens para autenticación
model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  machineId String?
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

//Licencia
model Licence{
  id            Int       @id @default(autoincrement())
  user          User      @relation(fields: [userId], references: [id])
  userId        Int       @unique
  licenceKey    String    @unique
  status        String
  issuedAt      DateTime  @default(now()) 
  expiresAt     DateTime
  type          String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

