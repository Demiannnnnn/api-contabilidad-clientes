generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../docs/erd.svg"
}


// ============================================
// Usuario — matching app's SQLite users table
// ============================================
model User {
  id                    Int       @id @default(autoincrement())
  email                 String    @unique
  passwordHash          String
  rut                   String?
  nombre                String?
  rol                   String    @default("trabajador")  // dueño, administrador, trabajador, cajero, contador
  permisos              String    @default("{}")         // JSON de permisos granulares
  activo                Boolean   @default(true)
  requiereAutorizacion  Boolean   @default(false)
  ultimoAcceso          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  clientes              Cliente[]
  productos             Producto[]
  documentos            Documento[]
  trabajadores          Trabajador[]
  categorias            Categoria[]

  // Relación jerárquica: trabajadores pertenecen a un dueño
  duenoId               Int?
  dueno                 User?     @relation("Trabajadores", fields: [duenoId], references: [id])
  trabajadoresHijos     User[]    @relation("Trabajadores")

  // Relación Contador
  clientesAsignados     ContadorCliente[] @relation("ContadorRelacion")
  misContadores         ContadorCliente[] @relation("ClienteRelacion")

  // Relación Licence
  licence               Licence[]

  // Relación RefreshToken
  refreshTokens         RefreshToken[]

  // Relación MachineBinding
  machinesOwned         MachineBinding[]
}


// Relación Contador <-> Clientes (solicitud tipo red social)
model ContadorCliente {
  id            Int      @id @default(autoincrement())
  contadorId    Int
  contador      User     @relation("ContadorRelacion", fields: [contadorId], references: [id])
  clienteId     Int
  cliente       User     @relation("ClienteRelacion", fields: [clienteId], references: [id])
  estado        String   @default("pendiente") // pendiente, aceptada, rechazada
  solicitadoPor Int      // userId de quien envió la solicitud
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([contadorId, clienteId])
}

// ============================================
// Clientes — matching app's SQLite clientes table
// ============================================
model Cliente {
  id                  Int       @id @default(autoincrement())
  userId              Int
  user                User      @relation(fields: [userId], references: [id])

  rut                 String
  razonSocial         String
  nombreFantasia      String?
  giro                String?
  direccion           String?
  region              String?
  comuna              String?
  ciudad              String?
  telefono            String?
  email               String?

  tipoDocumento       String    @default("rut_empresa")
  contactoNombre      String?
  contactoCargo       String?
  contactoEmail       String?
  contactoTelefono    String?

  condicionPago       String    @default("contado")
  diasCredito         Int       @default(0)
  limiteCredito       Decimal   @default(0) @db.Decimal(12, 0)
  descuentoAutomatico Decimal   @default(0) @db.Decimal(5, 2)
  trabajadorId        Int?
  zona                String?
  listaPrecios        String    @default("normal")

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  documentos          Documento[]

  @@unique([userId, rut])
}

// Productos o servicios
model Producto {
  id          Int             @id @default(autoincrement())
  userId      Int
  user        User            @relation(fields: [userId], references: [id])
  codigo      String
  nombre      String
  descripcion String?
  precio      Decimal         @db.Decimal(10, 0)  // Sin decimales (pesos chilenos)
  stock       Int             @default(0)
  exento      Boolean         @default(false)     // ¿Exento de IVA?
  activo      Boolean         @default(true)

  // Campos adicionales que envía la app
  unidadMedida  String?       @default("UN")
  stockMinimo   Int           @default(0)
  stockMaximo   Int?
  costo         Decimal?      @db.Decimal(10, 0)
  localId       Int?          // ID local de la app para sync
  syncHash      String?
  syncStatus    String?       @default("synced")
  lastSyncedAt  DateTime?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       DocumentoItem[]

  categoriaId Int?
  categoria   Categoria?  @relation(fields: [categoriaId], references: [id])

  @@unique([userId, codigo])
}

// Documento tributario (Factura o Boleta)
model Documento {
  id          Int              @id @default(autoincrement())
  userId      Int
  user        User             @relation(fields: [userId], references: [id])
  
  // Identificación local y sync
  localId     Int?             // ID local de la app para sync
  
  // Tipo y número
  tipoDocumento   Int          // Código documento: 33, 34, 39, 41, 52, 56, 61
  folio           Int          // Número de folio
  
  // Fechas
  fechaEmision      DateTime   @default(now())
  fechaVencimiento  DateTime?
  
  // Cliente (opcional para boletas)
  clienteId           Int?
  cliente             Cliente?         @relation(fields: [clienteId], references: [id])
  clienteRut          String?
  clienteRazonSocial  String?
  clienteGiro         String?
  clienteDireccion    String?
  clienteComuna       String?
  
  // Montos (pesos chilenos, sin decimales)
  subtotal           Decimal   @db.Decimal(12, 0)
  montoExento        Decimal   @db.Decimal(12, 0) @default(0)
  descuentoGlobal    Decimal   @db.Decimal(12, 0) @default(0)
  iva                Decimal   @db.Decimal(12, 0) @default(0)
  total              Decimal   @db.Decimal(12, 0)
  
  // Forma de pago
  formaPago          String    @default("contado")
  formaPagoDetalle   String?
  condicionesPago    String?
  ordenCompra        String?
  
  // Despacho (para guías)
  direccionDespacho  String?
  fechaDespacho      DateTime?
  transportista      String?
  patente            String?
  
  // Estado
  estado      String           @default("pendiente") // borrador, pendiente, emitida, pagada, parcial, anulada, rechazada
  
  // Observaciones
  observaciones      String?   @db.Text
  
  // Integração SII
  trackIdSII         String?   // ID de seguimiento del SII
  estadoSII          String?   // Estado en el SII: ENVIADO, ACEPTADO, RECHAZADO, ERROR
  fechaEnvioSII      DateTime? // Fecha de envío al SII
  xmlEnviado         String?   @db.Text // XML del DTE enviado
  
  // Sincronización
  syncStatus         String?   @default("synced")
  syncHash           String?
  lastSyncedAt       DateTime?
  
  // Timestamps
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  // Relaciones
  items       DocumentoItem[]
  referencias ReferenciaDocumento[]
  
  // Conexión con trabajador
  trabajadorId Int?
  trabajador  Trabajador? @relation(fields: [trabajadorId], references: [id])

  @@unique([userId, tipoDocumento, folio])  // Folio único por tipo
  @@index([userId, fechaEmision])
  @@index([userId, estado])
  @@index([trackIdSII])
}

// Referencias de documentos (notas de crédito/débito)
model ReferenciaDocumento {
  id                      Int       @id @default(autoincrement())
  documentoId             Int
  documento               Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  tipoDocumentoReferencia Int
  folioReferencia         Int
  fechaReferencia         DateTime
  razonReferencia         String
  codigoReferencia        String?
  detalle                 String?
  createdAt               DateTime  @default(now())
}

// Items del documento
model DocumentoItem {
  id             Int       @id @default(autoincrement())
  documentoId    Int
  documento      Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  
  numeroLinea    Int       // Número de línea en el documento
  productoId     Int?      // Puede ser null si es un item libre
  producto       Producto? @relation(fields: [productoId], references: [id])
  codigoItem     String?   // Código del producto/servicio
  descripcion    String    // Descripción del item
  
  cantidad       Int       // Cantidad
  unidad         String    @default("UN") // Unidad de medida
  precioUnitario Decimal   @db.Decimal(12, 0) // Precio unitario
  descuento      Decimal   @db.Decimal(5, 2) @default(0) // % descuento
  descuentoMonto Decimal   @db.Decimal(12, 0) @default(0) // Monto descuento
  montoItem      Decimal   @db.Decimal(12, 0) // Subtotal del item
  exento         Boolean   @default(false) // Si es exento de IVA
  
  createdAt      DateTime  @default(now())
}

// Trabajador de empresa
model Trabajador{
  id          Int       @id @default(autoincrement())
  userId      Int       
  user        User      @relation(fields:[userId], references: [id])
  nombre      String
  rut         String
  cargo       String?
  email       String?
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  documentos Documento[]

  @@unique([userId, rut])
}

//Categoria
model Categoria{
  id          Int         @id @default(autoincrement())
  userId      Int
  user        User        @relation(fields:[userId], references: [id])
  nombre      String
  createdAt   DateTime    @default(now())
  productos   Producto[]

  @@unique([userId, nombre])
}

// Refresh tokens para autenticación
model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  machineId String?
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

//Licencia
model Licence{
  id            Int       @id @default(autoincrement())
  user          User      @relation(fields: [userId], references: [id])
  userId        Int       @unique
  licenceKey    String    @unique
  status        String
  issuedAt      DateTime  @default(now()) 
  expiresAt     DateTime
  type          String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Machine Binding — vincula instancias de la app con su dueño
model MachineBinding {
  id        Int      @id @default(autoincrement())
  machineId String   @unique
  ownerId   Int
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

